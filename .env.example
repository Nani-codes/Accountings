DATABASE_URL=postgresql+psycopg://workbench:workbench@localhost:5433/workbench

# Storage: local | s3
# local — disk under LOCAL_STORAGE_DIR
# s3 — MinIO (set S3_ENDPOINT) or real AWS (leave S3_ENDPOINT empty; use AWS_* below)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=tmp/uploads

# MinIO / LocalStack (optional). Leave blank for real AWS S3.
S3_ENDPOINT=http://localhost:9010
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=workbench
S3_REGION=us-east-1

# Real AWS S3 (used when STORAGE_BACKEND=s3 and S3_ENDPOINT is empty).
# Prefer these standard names; AWS_ACCESS_SECRET is also accepted as an alias.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET_NAME=
# AWS_REGION=ap-south-2

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=dev-change-me
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Vertex AI (Gemini)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=purplegrid
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/vertexai.json
VERTEX_MODEL_ID=gemini-2.5-flash

# TallyPrime hosted connector (dial-out from firm PC)
# The Accountings Connector runs on the firm PC and dials out to this API.
# Advisor can call tally_* tools to query live ledgers, day book, trial balance.
# No MCP required; connector uses WebSocket + JSON-RPC.
TALLY_TOKEN_PEPPER=dev-tally-pepper-change-me
TALLY_CONNECTOR_DOWNLOAD_URL=
TALLY_HEARTBEAT_STALE_SECONDS=60
TALLY_RPC_TIMEOUT_SECONDS=25.0

